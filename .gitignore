# Gradle / build output -- regenerated, never source
.gradle/
.kotlin/
build/
app/build/
captures/
*.log

# Local machine configuration
local.properties

# IDE
.idea/
*.iml

# OS
Thumbs.db
.DS_Store

# Test scratch
*.hprof

# Versioned APK archives are binary release artifacts, kept on disk and on the
# desktop package, not in git history.
backups/
*.apk

# Exception: the single latest tested build that ships with the repo. Keeping one
# APK here (and nowhere else) means a fresh clone can install the exact tested
# build without running Gradle, and there is still only ever one copy to update.
!release/*.apk

# Reverse-engineering reference material (official APK, jadx/apktool output) and
# the decompiler toolchain itself. These are ~1.3 GB of local scratch, far beyond
# GitHub's 100 MB per-file limit, and are not needed to build the app.
ref/
tools/

# Local scratch worktrees (duplicated full checkouts, never source)
.worktrees/
